terraform {
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 3.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.0"
    }
  }
}

# Authenticates via Azure CLI (az login)
provider "azurerm" {
  features {}
  subscription_id = var.subscription_id
}
